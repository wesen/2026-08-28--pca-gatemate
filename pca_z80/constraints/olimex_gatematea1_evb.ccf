# Olimex GateMateA1-EVB pin constraints for the PCA-Z80 system.
# Pins verified against the Cologne Chip datasheet package-pinout table
# (see ../2026-08-25--vm-cpu-gatemate/sources/board/gatemate-pin-reference.md).
# Reused unchanged from the sibling MATE-16 project.

# 10 MHz oscillator (package pin for IO_SB_A8) and user LED (IO_SB_B6).
Pin_in  "clk_10m"  Loc = "IO_SB_A8" | SCHMITT_TRIGGER=true;
Pin_out "user_led" Loc = "IO_SB_B6";

# FPGA user button (silkscreen FPGA_BUT1): LiteX platform file maps user_btn_n
# -> IO_SB_B7 (active-LOW, the _n suffix). top.sv inverts so but_sync=1 means
# pressed. (Confirmed against litex-boards olimex_gatemate_a1_evb.py.)
Pin_in  "fpga_but" Loc = "IO_SB_B7";

# Onboard UART through RP2040 UART0. Electrical direction from the schematic
# and pico-dirtyJtag firmware (TX=GPIO12, RX=GPIO13):
#   FPGA TX -> IO_SA_B6 -> RP2040 GPIO13/UART0_RX
#   FPGA RX <- IO_SA_A6 <- RP2040 GPIO12/UART0_TX
Pin_out "uart_tx_pin" Loc = "IO_SA_B6";
Pin_in  "uart_rx_pin" Loc = "IO_SA_A6";
